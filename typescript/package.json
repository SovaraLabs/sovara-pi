{
  "name": "@sovara/pi",
  "version": "0.1.3",
  "description": "Sovara tracing and lesson retrieval for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SovaraLabs/sovara-pi.git",
    "directory": "typescript"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "sovara",
    "observability"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:e2e": "vitest run test/e2e",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@sovara/sdk": "file:../../sovara/packages/typescript-sdk"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/SovaraLabs/sovara-pi/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/SovaraLabs/sovara-pi/issues"
  }
}
